<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1) Send any direct .html request to its clean URL (301, no loop).
    #    The homepage maps to the domain root.
    RewriteRule ^index\.html$ / [R=301,L,NE]
    RewriteCond %{THE_REQUEST} \s/+(.*?)\.html[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L,NE]

    # 2) Internally serve the matching .html file for clean URLs
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.html -f
    RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# HTML must never be stale so script/CSS updates apply immediately
<IfModule mod_headers.c>
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "public, max-age=0, must-revalidate"
        Header set X-Content-Type-Options "nosniff"
    </FilesMatch>
    <FilesMatch "\.(js|css)$">
        Header set Cache-Control "public, max-age=86400"
    </FilesMatch>
</IfModule>
